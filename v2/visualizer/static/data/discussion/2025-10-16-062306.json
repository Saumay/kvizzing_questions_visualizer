[{"timestamp": "2025-10-16T06:24:43Z", "username": "Khandoba", "text": "What language is this?", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T06:25:15Z", "username": "Abhishek S", "text": "Good question", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T06:25:34Z", "username": "Nikunj", "text": "Doitsu sounds japanese", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T06:25:56Z", "username": "Nikunj", "text": "Pretty close to dojitsu which is a technique used in Naruto", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T06:25:59Z", "username": "Sidhesh K K", "text": "Ninja Hatori?", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T06:26:17Z", "username": "Abhishek S", "text": "Do the other words sound Japanese too?", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T06:26:36Z", "username": "Khandoba", "text": "Vokietija sounds Nordic", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T06:26:42Z", "username": "Khandoba", "text": "What technique is rhat", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T06:27:21Z", "username": "Khandoba", "text": "Oh, are these words for something in different language?", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T06:27:36Z", "username": "Nikunj", "text": "Sharingan and other eye related gifts if I am not mistaken ‎<This message was edited>", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T06:27:39Z", "username": "Khandoba", "text": "A bar", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestam