[{"timestamp": "2025-10-29T04:15:10Z", "username": "Akshay", "text": "Pietermaritzburg", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:15:25Z", "username": "Akshay", "text": "Axar patel thrown off the train", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:16:03Z", "username": "Akshay", "text": "Thats the joke lol everytime he gets out - ‘bapu thrown off the train again’", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:16:06Z", "username": "Pavan Pamidimarri", "text": "this is the place that started Mohandas’s journey to mahatma-hood", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:16:44Z", "username": "Khandoba", "text": "From hood to mahatma-hood?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:16:46Z", "username": "Lzafeer Ahmad B F", "text": "I had gone to Aligarh last month and was fascinated to learn how Aligarh history goes back at least 500 years. The university was set up in 1850s", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:17:34Z", "username": "Lzafeer Ahmad B F", "text": "Wonder why university towns never really took off as such in India.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:17:52Z", "username": "Akshay", "text": "Land", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:17:59Z", "username": "Pavan Pamidimarri", "text": "people graduate and then move on to where the jobs are", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:18:05Z", "username": "Akshay", "text": "The US is huuge", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:18:05Z", "username": "Pavan Pamidimarri", "text": "in the big cities", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:18:16Z", "username": "Lzafeer Ahmad B F", "text": "And I mean that in a comparative sense to my limited knowledge and exposure of western university towns", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:18:26Z", "username": "Lzafeer Ahmad B F", "text": "US, UK", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:18:26Z", "username": "Pavan Pamidimarri", "text": "All the talent from Aligarh goes straight to Delhi and Bombay", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:18:57Z", "username": "Akshay", "text": "Bengaluru", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:19:17Z", "username": "Pavan Pamidimarri", "text": "yes now that’s a bigger draw", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:19:46Z", "username": "Abhishek S", "text": "With some of these colleges so far outside city limits in the middle of nowhere, it is as close to we can get to university towns with our population", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:20:19Z", "username": "Pavan Pamidimarri", "text": "yeah, Kharagpur is like that too. small town with nothing but the railway station and college", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:20:20Z", "username": "Lzafeer Ahmad B F", "text": "Nagarbhavi memories ?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:20:29Z", "username": "Abhishek S", "text": "But then the city expands and it all becomes part of it", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:20:44Z", "username": "Abhishek S", "text": "Yup, especially my last statement", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T04:20:48Z", "username": "Abhishek S", "text": "How it has changed", "role": "chat", "is_correct": null, "has_media": false, "media": null}]