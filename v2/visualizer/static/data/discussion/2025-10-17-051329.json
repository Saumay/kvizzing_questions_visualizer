[{"timestamp": "2025-10-17T05:14:39Z", "username": "Shubham", "text": "Richard Gere and Shilpa?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:14:44Z", "username": "Shubhankar", "text": "History is only written by war winners (I feel there is a very thin line between the good and bad in Mahabharat)", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:15:44Z", "username": "Akshay", "text": "Diana ?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:15:57Z", "username": "Shubhankar", "text": "In the complete war, incidents of Pandavas being unethical are more than the other side.", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:16:14Z", "username": "Aditi Bapat", "text": "Rani Mukherjee is my guess", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:16:18Z", "username": "Akshay", "text": "Ehh there is a lot of revisionism", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:16:36Z", "username": "Akshay", "text": "For the most part good and evil is clearly demarcated", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:16:43Z", "username": "Shubhankar", "text": "And we come into terms by just saying everything is fair in love and war", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:16:54Z", "username": "Akshay", "text": "Yeah the anand neelakandan books are revisionist Mbh", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:17:03Z", "username": "Abhishek S", "text": "This is pre-independence", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:17:06Z", "username": "Akshay", "text": "It’s interesting but not super convincing", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:17:17Z", "username": "Sidhesh K K", "text": "Devika Rani?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:17:32Z", "username": "Sidhesh K K", "text": "First onscreen kiss right", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:17:33Z", "username": "Shubhankar", "text": "Exactly that what I wondered! Why would a king name his sons that!", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:17:39Z", "username": "Sidhesh K K", "text": "Don't know the rest", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:17:47Z", "username": "Abhishek S", "text": "Yup, she is the \"Queen\", known for the first kissing scene in Bollywood in Achut Kanya", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:18:21Z", "username": "Abhishek S", "text": "Any guesses on the lab technician turned leading man?", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:18:28Z", "username": "Akshay", "text": "Guru D ?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:18:29Z", "username": "Abhishek S", "text": "Or the studio boss?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:18:31Z", "username": "Akshay", "text": "?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:19:18Z", "username": "Abhishek S", "text": "Nope.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:19:30Z", "username": "Akshay", "text": "Wasnt he a lab tech ?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:19:34Z", "username": "Sidhesh K K", "text": "Himanshu Rai was boss or actor", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:19:54Z", "username": "Abhishek S", "text": "Himanshu Rai - the studio boss of Bombay Talkies", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:20:26Z", "username": "Abhishek S", "text": "The most famous name is missing 😀", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:20:51Z", "username": "Abhishek S", "text": "And literally a name for people who have no name 🙊", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:20:57Z", "username": "Khandoba", "text": "Ashok Kumar", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:21:11Z", "username": "Abhishek S", "text": "Yup, callback to the John Doe question", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:21:33Z", "username": "Khandoba", "text": "Damn, i was thinking who’s old enough to be that and took me too long to arrive there", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:21:37Z", "username": "Akshay", "text": "That’s not how it’s justified at all. The disintegration of norms started with the kauravas who hunted down abhimanyu like a pack of wolves.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:21:46Z", "username": "Abhishek S", "text": "To watch a fictionalised version of this real story, watch Jubilee by Vikramaditya Motwane", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:23:07Z", "username": "Shubhankar", "text": "Brother I’m not defending Kauravas at all. All I’m saying is that Pandavas are glorified just because they won the war. But they were more unethical even before the war started", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:23:32Z", "username": "Akshay", "text": "They weren’t", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:25:49Z", "username": "Akshay", "text": "Interesting story", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:26:24Z", "username": "Shubhankar", "text": "1. Draupadi being shared as wife.\n2. ⁠Betting her in the gamble.\n3. ⁠Lakshagrih (letting their cousins die instead of them)\n4. ⁠Cheap tactics of using shikhadi against Dronacharya\n5. ⁠Ashwatthama rumour\n6. ⁠Asking for Karna’s kavach and kundal cause they were no match.\n(Not justifying what Kauravas did at all)", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:26:49Z", "username": "Abhishek S", "text": "Najmul Hasan was the co-actor who got kicked out of the film, giving Ashok Kumar his shot.", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:27:08Z", "username": "Shubhankar", "text": "All I’m saying is they dint fight fair too.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:27:45Z", "username": "Akshay", "text": "When was this??", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:28:00Z", "username": "Naman Maheshwari", "text": "No such thing as fighting fair tbh.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-17T05:29:25Z", "username": "Shubhankar", "text": "Exactly my point!", "role": "chat", "is_correct": null, "has_media": false, "media": null}]