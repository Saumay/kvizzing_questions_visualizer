[{"timestamp": "2025-12-16T05:10:40Z", "username": "Kintu", "text": "Oh is it something to do with looking at the stars behind the moon", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-12-16T05:11:04Z", "username": "Sayu Sekhar", "text": "solar eclipse wala?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-12-16T05:11:08Z", "username": "Pavan Pamidimarri", "text": "Correct", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-16T05:11:14Z", "username": "Pavan Pamidimarri", "text": "Total solar eclipse", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-16T05:13:29Z", "username": "Pavan Pamidimarri", "text": "Einstein came up with his theory in 1916. When do you think Eddington and his colleagues managed to perform this experiment?", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-16T05:14:02Z", "username": "Sayu Sekhar", "text": "1920 ?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-12-16T05:14:51Z", "username": "Pavan Pamidimarri", "text": "Close enough, 1919. WW1 ended in November 1918, so they went chasing the next solar eclipse in 1919", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]