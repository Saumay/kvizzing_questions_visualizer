[{"timestamp": "2026-08-28T16:28:32Z", "username": "Abhishek Vats", "text": "Y is the national anthem?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2026-08-28T16:29:04Z", "username": "Pavan Pamidimarri", "text": "Correct, Anderson was supposed to sing the national anthem but couldn't get to the stage on time because the turnout was much bigger than she expected", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-08-28T16:30:21Z", "username": "Pavan Pamidimarri", "text": "in 1939, think of a prominent woman who would support a Black singer, and had the power to let her perform at the Lincoln Memorial", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-08-28T16:31:39Z", "username": "Abhishek", "text": "Eleanor Roosevelt", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2026-08-28T16:32:11Z", "username": "Pavan Pamidimarri", "text": "Correct, Eleanor Roosevelt resigned from DAR to protest their treatment of Marian Anderson", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-08-28T16:32:34Z", "username": "Pavan Pamidimarri", "text": "Akshay: 45, Vats: 80, Rahul: 10", "role": "chat", "is_correct": null, "has_media": false, "media": null}]