[{"timestamp": "2025-11-17T04:06:25Z", "username": "Naman Maheshwari", "text": "Hearsay", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:06:26Z", "username": "Nikhil Borra", "text": "She said?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:06:57Z", "username": "Lzafeer Ahmad B F", "text": "Ipse something", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:07:06Z", "username": "Akshay", "text": "Duress?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:07:13Z", "username": "Srikanth Kapali", "text": "Auditum", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:07:29Z", "username": "Nikhil Borra", "text": "Confession?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:07:33Z", "username": "Pavan Pamidimarri", "text": "Hint: the person who is doing the saying in this context is called an affiant.", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:07:38Z", "username": "Srikanth Kapali", "text": "Rumor", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:08:04Z", "username": "Lzafeer Ahmad B F", "text": "Affidavit ?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:08:21Z", "username": "Pavan Pamidimarri", "text": "Correct, affidavit means “he declared”", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:08:26Z", "username": "Pavan Pamidimarri", "text": "or “he said under oath.\"", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-17T04:09:09Z", "username": "Pavan Pamidimarri", "text": "i found out while making this set that Supreme Court ruled that affidavits can’t be used by themselves (“per se”) as evidence", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]