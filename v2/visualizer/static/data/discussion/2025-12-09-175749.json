[{"timestamp": "2025-12-09T17:58:13Z", "username": "Akshay", "text": "Wadera?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-12-09T17:58:36Z", "username": "Pavan Pamidimarri", "text": "no", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-09T17:58:45Z", "username": "Akshay", "text": "Lambardari?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-12-09T17:58:59Z", "username": "Pavan Pamidimarri", "text": "It was also known as Mahalwari", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-09T17:59:12Z", "username": "Pavan Pamidimarri", "text": "relied on Lamberdars as village headmen", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-09T17:59:29Z", "username": "Pavan Pamidimarri", "text": "unlike zamindari and ryotwari, this system was a collective taxation system", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-09T18:00:10Z", "username": "Kartikey Pradhan", "text": "Lambardars were also colloquially known as numberdars", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-09T18:00:24Z", "username": "Pavan Pamidimarri", "text": "Mahal was a word for village — a group of houses i guess", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]