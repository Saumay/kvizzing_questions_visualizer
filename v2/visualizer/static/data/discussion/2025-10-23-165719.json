[{"timestamp": "2025-10-23T16:58:05Z", "username": "Abhishek S", "text": "Imagining that song instead of Eye of the tiger just changes the vibe completely", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T16:58:12Z", "username": "Pranav", "text": "queen", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-23T16:58:18Z", "username": "Pranav", "text": "another one bites the dust?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-23T16:58:22Z", "username": "Lzafeer Ahmad B F", "text": "Yeah. I can’t even imagine how that song would fit it", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T16:58:25Z", "username": "Abhishek S", "text": "Yup", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T16:58:42Z", "username": "Arjun", "text": "Fun fact: NM (Narsee Monjee) shows an adaptation of this play to the new incoming MBA batch every year.\nSource: An alum 😅", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T16:58:45Z", "username": "Khandoba", "text": "Would have changed the tone", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T16:59:05Z", "username": "Lzafeer Ahmad B F", "text": "I didn’t know Eye of the Tiger was created specifically for the movie", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T16:59:39Z", "username": "Abhishek S", "text": "Adaptation of 12 Angry Men? Like: Ek ruka hua faisla?", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T16:59:41Z", "username": "Lzafeer Ahmad B F", "text": "Apparently even in his run the bit where the vendors throw a fruit to him was an impromptu", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:00:03Z", "username": "Lzafeer Ahmad B F", "text": "And they decided to keep it", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:00:07Z", "username": "Abhishek S", "text": "The original title for the song was Survival", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:01:52Z", "username": "Arjun", "text": "Yes", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:06:49Z", "username": "Lzafeer Ahmad B F", "text": "We were also shown this movie by a professor on our first day in law college. Really struggled to get through it and left me questioning my decision to join law", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:08:16Z", "username": "Abhishek S", "text": "Very misleading too, kyon dikha rahe ho jab jury system hi nahi yaha par", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:08:27Z", "username": "Abhishek S", "text": "Dikhani hai to Damini dikhao 😂", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:09:17Z", "username": "Khandoba", "text": "Pata chala saare students Sunny Deol wali body bana rahe hai class bunk karke", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:10:51Z", "username": "Abhishek S", "text": "And threatening the opposing counsel in moot courts with \"Judge order order karta reh jaayega aur tu pitta rahega\"", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:12:47Z", "username": "Lzafeer Ahmad B F", "text": "And the next day given an assignment on the Nanavati case", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:13:21Z", "username": "Abhishek S", "text": "Thank god us time par Rustom release nahi hui thi (I assume)", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:14:18Z", "username": "Abhishek S", "text": "But that feels like a set up for, see, that's why we don't have a jury system", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:14:35Z", "username": "Lzafeer Ahmad B F", "text": "Yes. That was exactly why.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:14:41Z", "username": "Abhishek S", "text": "Which wasn't the point of 12 Angry Men", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:15:14Z", "username": "Lzafeer Ahmad B F", "text": "Now you know why I was left confused", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:15:24Z", "username": "Lzafeer Ahmad B F", "text": "😒", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:18:08Z", "username": "Abhishek S", "text": "I feel all first year law students should be shown Chaitanya Tamhane's Court on the first day. Half of them would seriously reconsider their choice by the end of it ‎<This message was edited>", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:18:23Z", "username": "Lzafeer Ahmad B F", "text": "Such a beautiful movie", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:19:00Z", "username": "Lzafeer Ahmad B F", "text": "And anyone who decides to do law after watching Suits should be prohibited from doing law", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:19:51Z", "username": "Lzafeer Ahmad B F", "text": "But who am I to say anything. Alan Shore aur Denny Crane ki tarah balcony mein cigar aur on the rocks ke sapne humare bhi the", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:20:08Z", "username": "Abhishek S", "text": "Main Practice aur Ally Mcbeal dekh kar gaya tha law school 😔", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:20:11Z", "username": "Lzafeer Ahmad B F", "text": "But more Practice", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:20:13Z", "username": "Khandoba", "text": "Is that a Boston Legal reference", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:20:18Z", "username": "Lzafeer Ahmad B F", "text": "And less Boston Legal", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:20:22Z", "username": "Khandoba", "text": "🫡", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:22:23Z", "username": "Lzafeer Ahmad B F", "text": "You did NLS?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-23T17:23:38Z", "username": "Abhishek S", "text": "I mean, kinda. I went there, and was there for 6 years. Not that I \"did\" anything", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}]