[{"timestamp": "2025-11-25T16:38:06Z", "username": "Nikhil Borra", "text": "Adding Secular and Socialist to the Preamble?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-11-25T16:38:23Z", "username": "Abhishek S", "text": "That came much later. 42nd amendment.", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-25T16:39:15Z", "username": "Abhishek S", "text": "This one was a big political move as well.", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-25T16:40:42Z", "username": "Abhishek S", "text": "The 26th Amendment was brought in to abolish something.", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-25T16:41:48Z", "username": "Nikhil Borra", "text": "Princely purses?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-11-25T16:42:37Z", "username": "Abhishek S", "text": "Privy purses is correct. The amendment abolished all the honorary titles and allowances for the erstwhile royals.", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-25T18:18:41Z", "username": "Lzafeer Ahmad B F", "text": "Called a betrayal of a constitutional promise", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-25T18:20:05Z", "username": "Lzafeer Ahmad B F", "text": "It was one of the promises made to the princely states to join the union of India at the time of independence", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-25T18:20:15Z", "username": "Lzafeer Ahmad B F", "text": "The privy purses", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-25T18:21:11Z", "username": "Abhishek S", "text": "Yup, in the accession document", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-25T18:21:44Z", "username": "Abhishek S", "text": "There was a constitutional provision for it too which is why an amendment was necessary", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-25T18:22:30Z", "username": "Abhishek S", "text": "Article 291", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]