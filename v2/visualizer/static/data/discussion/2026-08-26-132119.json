[{"timestamp": "2026-08-26T13:31:28Z", "username": "Anurag Bhide", "text": "Does it have something to do with Peloton?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2026-08-26T13:33:38Z", "username": "Gautam Ramachandran", "text": "The owner is a pretty easy one, think of the most obvious answer", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-08-26T13:37:52Z", "username": "Anurag Bhide", "text": "Lance Armstrong? 😅", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2026-08-26T13:41:15Z", "username": "Akshay", "text": "I think it comes from french for the yellow jersey", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2026-08-26T13:41:41Z", "username": "Gautam Ramachandran", "text": "Yep!\nOnto the nanes:\nMellow Johnny's is a wordplay on the French phrase, maillot jaune.\nAnd Juan Pelota is also a kind of wordplay- Pelota being Spanish for 'ball'.\nAny guesses on the funda?", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-08-26T13:41:48Z", "username": "Gautam Ramachandran", "text": "Perfect. Maillot Jaune is the Yellow Jersey!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-08-26T13:42:42Z", "username": "Anurag Bhide", "text": "Juan = one?", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-08-26T13:42:57Z", "username": "Anurag Bhide", "text": "One ball?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2026-08-26T13:43:28Z", "username": "Gautam Ramachandran", "text": "Perfect!!\nJuan Pelota, or \"One Pelota\", because of him getting it removed when diagnosed with testicular cancer.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-08-26T13:43:57Z", "username": "Gautam Ramachandran", "text": "Beautiful cracks @Akshay KVizzing , @Anurag Bhide", "role": "chat", "is_correct": null, "has_media": false, "media": null}]