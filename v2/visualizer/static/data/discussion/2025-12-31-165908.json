[{"timestamp": "2025-12-31T17:00:15Z", "username": "Lzafeer Ahmad B F", "text": "Someone tried pot for the first time but realised later it didn't have weed?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-12-31T17:00:54Z", "username": "Lzafeer Ahmad B F", "text": "Or didn't inhale.", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-12-31T17:01:21Z", "username": "Abhishek S", "text": "I did not inhale is the quote", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-31T17:01:32Z", "username": "Lzafeer Ahmad B F", "text": "Bill Clinton?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-12-31T17:02:06Z", "username": "Abhishek S", "text": "Bill Clinton's \"I experimented with it but did not inhale\"", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-31T17:02:45Z", "username": "Abhishek S", "text": "Can you tell what one of his successors said to a similar question, and almost a retort to Clinton?", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-31T17:04:11Z", "username": "Lzafeer Ahmad B F", "text": "Oh Obama said - if I did smoke I made sure to inhale a lot.", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-31T17:04:40Z", "username": "Abhishek S", "text": "Close enough. He said, of course I inhaled. That's the point.", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]