ct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:01:43Z", "username": "Pavan Pamidimarri", "text": "I struggle with this. I try to enjoy the work, but once I know something really bad about the author, I find it hard to read more.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:02:14Z", "username": "Kartikey Pradhan", "text": "Ok, set of 12", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:02:22Z", "username": "Kartikey Pradhan", "text": "##quiz start", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:02:28Z", "username": "Kartikey Pradhan", "text": "First one:", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:02:29Z", "username": "మాन$", "text": "I know one answer already", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:02:31Z", "username": "మాन$", "text": "Actually 3", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:02:36Z", "username": "Kartikey Pradhan", "text": "Sure go ahead", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:02:39Z", "username": "Kartikey Pradhan", "text": "Then I will start", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:02:41Z", "username": "Khandoba", "text": "🤣🤣🤣", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:04:26Z", "username": "Kartikey Pradhan", "text": "I think I’ll start, can’t wait for predictions", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-05T17:04:31Z", "username": "Kartikey Pradhan", "text": "First one:", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {