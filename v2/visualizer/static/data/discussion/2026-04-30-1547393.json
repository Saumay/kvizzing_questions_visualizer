ia": null}, {"timestamp": "2026-04-30T15:49:10Z", "username": "Chinmay Mehta", "text": "Next", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:49:36Z", "username": "Chinmay Mehta", "text": "16.  the 2000 Sydney Games, a swimmer from Equatorial Guinea gained international fame despite being the slowest athlete in the pool. He had only learned to swim eight months prior in a 20-meter hotel pool and had never seen a 50-meter Olympic pool before. He swam his heat alone after his competitors were disqualified, as the audience cheered him on,  and his time was so slow it took him nearly twice as long as the gold medalist. By what affectionate nickname was he known?", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:49:40Z", "username": "Abhishek Vats", "text": "Thorpe", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:49:46Z", "username": "Abhishek Saluja", "text": "Thorpedo", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:49:46Z", "username": "Pavan Pamidimarri", "text": "eel", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:49:47Z", "username": "Abhishek Vats", "text": "Arey nahi", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:49:47Z", "username": "Pavan Pamidimarri", "text": "eric", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:49:54Z", "username": "Tapish", "text": "Eric the eel", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:49:56Z", "username": "Chinmay Mehta", "text": "Pavan gets it", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:50:15Z", "username": "Chinmay Mehta", "text": "Vats: 65, Kp: 60, Khandoba: 10, Pavan: 20, Tapish: 5, Gautam: 5, Sal: 5", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:50:16Z", "username": "Abhishek Vats", "text": "Arey yaar 2000 swimmer padh k false start ho gya 🙈", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:50:27Z", "username": "Chinmay Mehta", "text": "Next", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:50:42Z", "username": "Chinmay Mehta", "text": "17. At the 1920 Antwerp Games, an American diver won a bronze medal and celebrated by performing a \"heist\" on a dare from his teammates. Under the cover of night, he climbed a 15-foot flagpole at the stadium, untied a specific piece of official property, and stuffed it into the bottom of his suitcase. For the next 80 years, the Olympic Committee assumed the item had been lost or destroyed during the war. It wasn't until the diver was 103 years old that he finally confessed to having it in his closet the whole time. In a special ceremony at the 2000 Games, he finally returned the contraband. What did he steal?", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:50:49Z", "username": "Abhishek Vats", "text": "Flag", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:50:52Z", "username": "Abhishek Vats", "text": "Olympic", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T15:50:55Z", "username": "Chinmay Mehta", "text": "More specific", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]