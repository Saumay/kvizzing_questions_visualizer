[{"timestamp": "2025-10-11T16:17:13Z", "username": "Tapish", "text": "Shakuntala", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:17:16Z", "username": "Tapish", "text": "?", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:17:29Z", "username": "Pavan Pamidimarri", "text": "good guess but no, that’s a play not a mahAkAvya", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:18:08Z", "username": "Tapish", "text": "Kumara Sambhavam?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:18:11Z", "username": "Pavan Pamidimarri", "text": "Hint: the opening verse compares Parvati and Parameshvara to a word and its meaning, and pays obeisance to them as the inseparable parents of the universe. However the book is not about those gods at all.", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:18:29Z", "username": "Pavan Pamidimarri", "text": "Not Kumarasambhavam, that IS about Parvati and Shiva", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:18:38Z", "username": "Pavan Pamidimarri", "text": "no", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:18:54Z", "username": "Akshay", "text": "It’s the poem on rama?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:19:01Z", "username": "Pavan Pamidimarri", "text": "right track", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:19:06Z", "username": "Akshay", "text": "Raghuvanshi", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:19:10Z", "username": "Akshay", "text": "Or something", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:19:15Z", "username": "Pavan Pamidimarri", "text": "will give it to you", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:19:18Z", "username": "Pavan Pamidimarri", "text": "as KV says", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:19:29Z", "username": "Akshay", "text": "Raghuvansham", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:19:33Z", "username": "Akshay", "text": "To make it proper", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:19:47Z", "username": "Pavan Pamidimarri", "text": "The answer is _raghuvamsham_. The opening verse compares Parvati and Parameshvara to a word and its meaning, and pays obeisance to them as the inseparable parents of the universe. You can hear it in the first 45 seconds of this song from a 1980s Telugu movie: https://www.youtube.com/watch?v=lDt2L0VDO3k.", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:20:24Z", "username": "Pavan Pamidimarri", "text": "This book was used by Gupta kings, who identified themselves with Vishnu, to legitimize and sanctify their rule. ‎<This message was edited>", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:20:54Z", "username": "Pavan Pamidimarri", "text": "This rendition in this video in its last line plays a neat trick of giving a second meaning to the verse, bowing to Shiva (_pArvatIpa_) and Vishnu (_ramEshvara_) as the inseparable parents of the universe.", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-11T16:21:29Z", "username": "Pavan Pamidimarri", "text": "Here is a commemorative cover issued by India Post to celebrate Kalidasa, along with stamps featuring scenes from _abhijnAna shAkuntalam_ and _mEghadUtam_: ‎image omitted", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}]