[{"timestamp": "2025-11-16T21:43:14Z", "username": "Abhishek S", "text": "The title of the poem and the person Iqbal refers to as Imam-e-hind is Ram, or Lord Rama.", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-16T21:43:50Z", "username": "Abhishek S", "text": "है राम के वजूद पे हिन्दोस्ताँ को नाज़\nअहल-ए-नज़र समझते हैं इस को इमाम-ए-हिंद", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-16T21:52:54Z", "username": "Pavan Pamidimarri", "text": "Rama", "role": "attempt", "is_correct": true, "has_media": false, "media": null}]