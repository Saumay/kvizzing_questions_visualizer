estamp": "2025-11-25T19:53:02Z", "username": "Tapish", "text": "Chaplain.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-11-25T19:54:27Z", "username": "Tapish", "text": "Mark Tronson was the Aussie chaplain and Digby was England’s.", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]