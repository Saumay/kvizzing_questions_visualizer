[{"timestamp": "2025-10-29T18:59:30Z", "username": "Lzafeer Ahmad B F", "text": "Me among the semifinalists ‎GIF omitted", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T18:59:42Z", "username": "Khandoba", "text": "The DAWG", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:00:37Z", "username": "Khandoba", "text": "Here comes the bride Indian version", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:01:38Z", "username": "Abhishek S", "text": "Is there a name for Pe pe pe pe pe pe pe pain ?", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:01:52Z", "username": "Khandoba", "text": "Exactly what played in my mind", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:02:21Z", "username": "Khandoba", "text": "Shadi wala shehnai hi hoga but what’s the name for it", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:02:43Z", "username": "Abhishek S", "text": "Oh there is also shehanai in Doordarshan one", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:02:59Z", "username": "Abhishek S", "text": "Pe pe pe pe pain, pe pe pain pe pain", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:03:02Z", "username": "Pavan Pamidimarri", "text": "yeah the shehnai is a bit of a misdirect, nothing to do with weddings", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:03:10Z", "username": "Pavan Pamidimarri", "text": "right track", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:03:28Z", "username": "Abhishek S", "text": "The concentric circles forming the logo", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:03:32Z", "username": "Nikhil Borra", "text": "Doordarshan theme?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:03:39Z", "username": "Aditi Bapat", "text": "You do realize this doesn't convey it the way you think it does. 😂", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:03:40Z", "username": "Lzafeer Ahmad B F", "text": "The DD theme.", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:03:51Z", "username": "Lzafeer Ahmad B F", "text": "ZNMD mein they do it also", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:04:02Z", "username": "Khandoba", "text": "Hey, I heard it perfectly😆", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:04:11Z", "username": "Abhishek S", "text": "It depends if you sing to it in your head 😜", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:04:27Z", "username": "Pavan Pamidimarri", "text": "https://www.youtube.com/watch?v=C15BreteeAI", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:04:37Z", "username": "Lzafeer Ahmad B F", "text": "I read this in the tone of that Hindi song Pyon Pyon Pyon. Where they do a weird cheek dance step", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:04:53Z", "username": "Pavan Pamidimarri", "text": "easy one: what poem is it based on?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:05:07Z", "username": "Abhishek S", "text": "Used to sit in front of the TV and wait for the logos to form cause it was so long, and yet so entertaining!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:05:18Z", "username": "Khandoba", "text": "Saare Jahan se Achha?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:06:00Z", "username": "Aditi Bapat", "text": "Not just 80s kids though. I grew up with no cable connection until 12th grade, so DD is an integral part of my childhood. Itne bhi बुजुर्ग nahi ho aap😜", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:06:01Z", "username": "Lzafeer Ahmad B F", "text": "Winamp visualisations had nothing on this.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:06:38Z", "username": "Lzafeer Ahmad B F", "text": "Almost Same!  No cable till 9th.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:06:47Z", "username": "Khandoba", "text": "Me too till 10th, ye Indian parents ka formula tha to get good score in boards I guess", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:07:23Z", "username": "Abhishek S", "text": "Cable katwa dete the exams se pehle 😞", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:07:35Z", "username": "Lzafeer Ahmad B F", "text": "Having DD2/ Metro itself felt like a huge boost! Imagine the number of channel options doubling. Just like that", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:08:04Z", "username": "Abhishek S", "text": "But I had figured out how to get cable, at least a pixelated form of it, by just inserting a bobby pin where the port was", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:08:32Z", "username": "Pavan Pamidimarri", "text": "we didn’t get a DD2 in Hyderabad until the 90s when cable was already ubiquitous", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:08:50Z", "username": "Khandoba", "text": "I didn’t even get awareness till mid 90s", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:09:02Z", "username": "Khandoba", "text": "Then I was born and BAM!!!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:09:20Z", "username": "Pavan Pamidimarri", "text": "i remember my kid brother having to go up on teh roof and hold the anetanna just so, so that we can confirm good signal for cricket matches", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:09:23Z", "username": "Lzafeer Ahmad B F", "text": "And there was that really weird hack of pointing antenna to a weird cable box. And you could leech a very grainy cable channel", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:09:23Z", "username": "Abhishek S", "text": "And the static, I could stare at the black and white static and even that was entertaining than nothing at all. See, the white dots were the Pandavas and the black dots were Kauravas. And you were now watching Mahabharat.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:09:46Z", "username": "Lzafeer Ahmad B F", "text": "The only reason we hated monsoons as kids.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:09:47Z", "username": "Abhishek S", "text": "That was my Dad on Sunday mornings", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:10:12Z", "username": "Abhishek S", "text": "So that we can watch Jungle Book", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:10:30Z", "username": "Pavan Pamidimarri", "text": "my job was to lift him up so he could go on teh roof. we didn’t have stairs to the roof back then, built them a couple of years later (after he fell on the way down and broke a bone)", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T19:10:39Z", "username": "Farhan", "text": "The kid brother. That's me climbing the wall", "role": "chat", "is_correct": null, "has_media": false, "media": null}]