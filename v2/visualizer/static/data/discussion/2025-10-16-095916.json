[{"timestamp": "2025-10-16T09:59:30Z", "username": "Pavan Pamidimarri", "text": "Also FITB", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T09:59:49Z", "username": "Nikhil Borra", "text": "Curry?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-16T09:59:49Z", "username": "Surabhi", "text": "Japanese curry", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:00:03Z", "username": "Surabhi", "text": "Curry powder", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:00:25Z", "username": "Pavan Pamidimarri", "text": "Yes Japanese curry, the thicker and sweeter dish than we are used to, made with curry powder", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:00:48Z", "username": "Pavan Pamidimarri", "text": "now usually served as katsu curry with tonkatsu or chicken katsu", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:01:15Z", "username": "Surabhi", "text": "It’s pretty good", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:01:53Z", "username": "Pavan Pamidimarri", "text": "i like it, used to go to curry houses at least once a week when i lived in Tokyo", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:02:14Z", "username": "Pavan Pamidimarri", "text": "they have a 5 levels of spiciness, never got past level 4", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:02:44Z", "username": "Surabhi", "text": "I got a whole lot of the curry cubes back from Japan only to find that they also sell them on Amazon in India.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:03:04Z", "username": "Abhishek S", "text": "Never tried it, had a Japanese friend who couldn't eat any spicy food, and told me about how their curry is so much milder.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:03:25Z", "username": "Pavan Pamidimarri", "text": "yeah you have to do level 3 if you want normal level of desi spice", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:03:29Z", "username": "Pavan Pamidimarri", "text": "and 4 if you are Telugu", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:04:09Z", "username": "Pavan Pamidimarri", "text": "my adventurous Japanese friends would order 2", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:04:17Z", "username": "Surabhi", "text": "My spice tolerance is pretty low so I oscillate between 1&2 for good measure. ‎image omitted", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:04:25Z", "username": "Pavan Pamidimarri", "text": "and get red in the face eating it", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:06:01Z", "username": "Abhishek S", "text": "Knowing myself, I'll go for 5 and then die a happy man.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:06:21Z", "username": "Pavan Pamidimarri", "text": "some curry houses put ambulance icons next to level 5", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:06:46Z", "username": "Abhishek S", "text": "I had the audacity to ignore local Mexicans telling me it is \"Muy picante\" and adding more green salsa to my Pozole. Died.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:07:01Z", "username": "Pavan Pamidimarri", "text": "oh yeah, Mexicans don’t mess around with spice", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:07:18Z", "username": "Surabhi", "text": "Neither do the Koreans", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:07:31Z", "username": "Pavan Pamidimarri", "text": "no wonder i like Mexican and Korean food", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:08:03Z", "username": "Pavan Pamidimarri", "text": "btw every country I go to, i ask the locals what cuisines they like. most people give a variety of answers. but the only country that surprised me was Korea", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:08:14Z", "username": "Pavan Pamidimarri", "text": "every Korean person in Korea I asked said their favorite cuisine in Korean", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:08:59Z", "username": "Abhishek S", "text": "@⁨Sidhesh K K⁩ This is the point I go, \"Korea re, Korea re, mera dil chura ke lejaa\" ‎<This message was edited>", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:09:16Z", "username": "Surabhi", "text": "Figures. They always go to Korean restaurants no matter what part of the world they’re in.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:15:31Z", "username": "Sidhesh K K", "text": "This is much better timing", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T10:15:41Z", "username": "Sumit Gupta", "text": "I still go to Curry House in India, every week, they are not as good but it works. They are quickly gaining attraction here", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]