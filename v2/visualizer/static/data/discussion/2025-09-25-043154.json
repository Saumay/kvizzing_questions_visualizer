[{"timestamp": "2025-09-25T04:31:58Z", "username": "Pavan Pamidimarri", "text": "Five ships – Concepción, San Antonio, Santiago, Trinidad and Victoria – set sail from Seville with about 250 people under the command of a Portuguese sailor. Just one of them – Victoria – made it to the destination with 18 survivors, after the original leader of the expedition died on the way. What remarkable feat did this expedition accomplish?", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:32:25Z", "username": "Prathamesh", "text": "His family is also the benefactor of the Jotiba temple of Kolhapur. Ranoji Shinde (before they became Scindia) had rebuilt it", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:32:46Z", "username": "Akshay", "text": "Jyotiraditya does speak v good Marathi", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:32:53Z", "username": "Akshay", "text": "I was surprised", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:32:56Z", "username": "Pavan Pamidimarri", "text": "why did they start writing their name as Scindia instead of Shinde? anyone know?", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:33:10Z", "username": "Akshay", "text": "Just an anglicization i think", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:33:21Z", "username": "Pavan Pamidimarri", "text": "oh", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:33:54Z", "username": "Prathamesh", "text": "Yes", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:35:03Z", "username": "Naman Maheshwari", "text": "Is this Vasco da Gama arriving in India?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:35:11Z", "username": "Pavan Pamidimarri", "text": "no", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:35:12Z", "username": "Pavan Pamidimarri", "text": "no", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:35:20Z", "username": "Kartikey Pradhan", "text": "Magellan", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:35:45Z", "username": "Naman Maheshwari", "text": "Eh, why did I think the destination was India -_-", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:35:47Z", "username": "Kartikey Pradhan", "text": "Circumnavigation of the earth?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:36:24Z", "username": "Pavan Pamidimarri", "text": "Correct, Magellan was also Portuguese, just 17 of the 250 made it back to Europe after circumnavigating the globe", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-09-25T04:37:24Z", "username": "Akshay", "text": "Hence the conspiracy theories* ‎<This message was edited>", "role": "chat", "is_correct": null, "has_media": false, "media": null}]