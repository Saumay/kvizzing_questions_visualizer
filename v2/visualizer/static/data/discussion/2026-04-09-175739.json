": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T17:59:03Z", "username": "Abhishek Saluja", "text": "Scores: Pavan 45, Bijal 10, Srijan 5", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T17:59:03Z", "username": "Srijan Naayak", "text": "I am content and not complaining ‎", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T17:59:34Z", "username": "bijal bhatt", "text": "Dhoni, trying top stop Sachin 200", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T17:59:39Z", "username": "Abhishek Saluja", "text": "Isabella II died on this day in 1904.", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:00:06Z", "username": "Srijan Naayak", "text": "Let's be allies and try to do that 😂", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:01:01Z", "username": "Abhishek Saluja", "text": "Okay, next one is one of my favourites from the set, the only one with just one part for full 20 pts. Please read carefully, need the exact answer.", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:01:41Z", "username": "Abhishek Saluja", "text": "4.\nOn 28 October 2010, Reddit user OrdinaryPanda posted a question on r/AskReddit: \"What word or phrase did you totally misunderstand as a child?\" In the comments, a user called Lard_Baron posted what would become one of the most upvoted replies in the subreddit's history.\nHe wrote that when he was young, his father said to him a well-known aphorism followed by the name of the person it is attributed to. The redditor, however, heard the attribution as two separate statements - the first being the aphorism itself, which made perfect sense, and the second being what sounded like a surreal geopolitical assertion about a European country.\nFor over a decade, he lived with this. When he said the full quote to people, they nodded knowingly. When someone else said the first half, he would finish with the second, and nobody batted an eye. He once asked a teacher to explain the full thing and got a ten-minute lecture on the first part but nothing on the second. When he pressed by repeating the second part in a questioning tone, the teacher just said \"yes.\" It was only years later, when he finally saw it written down, that the penny dropped.\nWhat two-part phrase did Lard_Baron think he was hearing? (20 pts) ‎", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:01:55Z", "username": "Khandoba", "text": "Knowledge is power", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:01:58Z", "username": "Khandoba", "text": "France is bacon", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:01:59Z", "username": "Pavan Pamidimarri", "text": "france is bacon", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:02:18Z", "username": "Khandoba", "text": "Ahahahahaha", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:02:25Z", "username": "Khandoba", "text": "Meme question aa gaya", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:02:25Z", "username": "Abhishek Saluja", "text": "And Khandoba cracks it fully (thankfully!)", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:02:50Z", "username": "Pavan Pamidimarri", "text": "only meme question i knew the answer to… but the rightful owner takes it", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:02:52Z", "username": "Abhishek Saluja", "text": "Francis Bacon died on this day in 1626.", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-09T18:03:01Z", "username": "Srijan Naayak", "text": "What a beautifully framed question, it's gonna be one of my top questions so far definitely.", "role": "chat", "is_correct": null, "has_media": false, "media": null}]