": "Abhishek Saluja", "text": "Hey, only Pavan gets to use this one!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-06T14:30:42Z", "username": "Akshay", "text": "Paisa nikal khandoba", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-06T14:30:49Z", "username": "Khandoba", "text": "Whaaaat", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-06T14:30:56Z", "username": "Khandoba", "text": "Since when", "role": "chat", "is_correct": null, "has_media": false, "media": null}]