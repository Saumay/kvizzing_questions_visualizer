ull}, {"timestamp": "2026-04-12T18:58:04Z", "username": "Dr.Namrata Srinivasan", "text": "Deal", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:58:19Z", "username": "Akshay", "text": "Thanks! That’s the plan 😁", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:58:20Z", "username": "Khandoba", "text": "Only person who thought this through as always🤣", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:58:22Z", "username": "Abhishek Vats", "text": "Have to make questions woman 😂\nDon't have to kill people 😂😂", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:58:59Z", "username": "Akshay", "text": "June 14 and September 17 ke QOTD pe dibs", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:01Z", "username": "Khandoba", "text": "When Wikipedia said “the list of dead people is incomplete, help us expand it”, Namrata took it literally", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:03Z", "username": "Ryan Colaço", "text": "No .\nYou will be at a boring ass dinner party, that you are obliged to attend... And pretend laugh at his/her lame jokes all evening, just to not appear disengaged\nThe whole time telling yourself isn't it enough seeing the same people over and over everyday at work that now you're also forced to socialise with them..\nNo?", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:04Z", "username": "Abhishek Vats", "text": "Question nahi ban Raha aaj. Chalo marwa dein kisi ko 😂", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:06Z", "username": "Saumay", "text": "That’s one way to make questions. Create your own trivia", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:16Z", "username": "Pavan Pamidimarri", "text": "she is not like your ordinary QMs who make questions about events that already happened in the world. she shapes the world she wants to see", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:20Z", "username": "Khandoba", "text": "Which one is your birthday?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:29Z", "username": "Akshay", "text": "Neither", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:33Z", "username": "Dr.Namrata Srinivasan", "text": "Ahahaha you get it my guy!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:36Z", "username": "Akshay", "text": "Guess whose b’days", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:40Z", "username": "Khandoba", "text": "A regular Gandhi", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:48Z", "username": "Dr.Namrata Srinivasan", "text": "Why I started drinking socially…", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T18:59:49Z", "username": "Tapish", "text": "Kya mast dark movie plot banega na yeh? A serial killer QM!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T19:00:32Z", "username": "Sidhesh K K", "text": "You should do one about broken HODdis", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T19:00:36Z", "username": "Khandoba", "text": "Buying rights right away", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-12T19:00:3