ame": "మాन$", "text": "Wonderful patience and wordings. Great questions as always @⁨KP KVizzing⁩ saab", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-11T15:57:05Z", "username": "Chinmay Mehta", "text": "Shall I run the map set now?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-11T15:58:13Z", "username": "Pavan Pamidimarri", "text": "if no one has volunteered yet, i can run tomorrow’s QOTD.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-11T15:58:20Z", "username": "Pavan Pamidimarri", "text": "if someone already has, i will wait for next weekend", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-11T15:58:25Z", "username": "మాन$", "text": "Yes. I want to earn some points.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-11T15:58:46Z", "username": "Abhishek Vats", "text": "No one has yet", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-11T15:58:58Z", "username": "Pavan Pamidimarri", "text": "perfect, i will run it tomorrow", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-11T15:59:01Z", "username": "Pavan Pamidimarri", "text": "let’s go Chinmay!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-11T15:59:10Z", "username": "Chinmay Mehta", "text": "Its not a full set set, didnt get time to make it complete, but still around 12-13 qs", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-11T15:59:14Z", "username": "మాन$", "text": "12 Apr", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-11T15:59:16Z", "username": "Chinmay Mehta", "text": "+10", "role": "chat", "is_correct": null, "has_media": false, "media"