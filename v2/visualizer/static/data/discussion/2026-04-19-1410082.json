[{"timestamp": "2026-04-19T14:10:49Z", "username": "A", "text": "Cigars?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:10:54Z", "username": "Kartikey Pradhan", "text": "Nope", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:11:21Z", "username": "Abhishek Vats", "text": "Hands and fingerprints?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:11:38Z", "username": "Sidhesh K K", "text": "Severed ones right", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:11:53Z", "username": "Kartikey Pradhan", "text": "Yes! His hands were amputated and stored in formaldehyde, and sent for fingerprint confirmation", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:12:06Z", "username": "Abhishek Saluja", "text": "Cue foreign hand joke", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:12:06Z", "username": "Abhishek Vats", "text": "Severed nahi hote toh body hi hoti fir toh 😂", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:12:27Z", "username": "Kartikey Pradhan", "text": "Guevara had no hand in his own death", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:12:47Z", "username": "Abhishek Saluja", "text": "You gotta hand it to them", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:13:08Z", "username": "Abhishek Saluja", "text": "Haath to aaya, muh na laga", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:13:14Z", "username": "A", "text": "Armed and fabulous", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:13:17Z", "username": "Kartikey Pradhan", "text": "Guevara and Castro walked hand in hand until his death and even afterwards ‎", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:13:44Z", "username": "Abhishek Vats", "text": "Haatho haath ek aur sawaal puch do 😂", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:13:51Z", "username": "Abhishek Saluja", "text": "Castro on receiving them: Haath hi mere saathi ‎", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:13:54Z", "username": "Sidhesh K K", "text": "Haath to aaye... muh baadme aayega ‎", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:13:54Z", "username": "Kartikey Pradhan", "text": "One thing that Guevara couldn’t be after his death was handsy", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:14:13Z", "username": "Kartikey Pradhan", "text": "Ok next:", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:14:56Z", "username": "Kartikey Pradhan", "text": "2. In April 1980, Bob Marley was invited to perform at the official independence ceremonies of X at the Rufaro Stadium. He was so committed to the event that he spent his own money to fly his crew and equipment to X. During the performance of the song \"Zion Train,\" the local police used tear gas to control the massive crowds outside the stadium, causing the band to flee the stage—except for Marley, who remained and continued singing through the fumes.\nIdentify the specific song that shares its name with X from the Survival album that had been adopted as an unofficial anthem by the local freedom fighters, and which Marley performed twice that night to satisfy the crowd. ‎", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:15:18Z", "username": "Chinmay Mehta", "text": "Zimbabwe", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:15:29Z", "username": "Abhishek Vats", "text": "Noice!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:15:31Z", "username": "Kartikey Pradhan", "text": "Zimbabwe is right!", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:15:32Z", "username": "Chinmay Mehta", "text": "Ye me wapas miss nahi karunga! Unlike Anirban with Bhutan!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-19T14:16:14Z", "username": "Kartikey Pradhan", "text": "For that night it was Zim-bob-we", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]