[{"timestamp": "2026-04-28T04:33:38Z", "username": "Saumay", "text": "Savarkar?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:33:39Z", "username": "Nikhil Borra", "text": "Ananda Math?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:33:48Z", "username": "Akshay", "text": "X is Savarkar", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:34:00Z", "username": "Saumay", "text": "Indian war of independence", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:34:16Z", "username": "Akshay", "text": "Y is The Indian War of Independence", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:35:28Z", "username": "Akshay", "text": "Germany was one of the few countries outside India with the ability to publish Z at the time, due to their fascination with India and Indian texts", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:36:03Z", "username": "Nikhil Borra", "text": "Devanagari script?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:36:29Z", "username": "Akshay", "text": "Z is Devnagari ‎", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:36:41Z", "username": "Akshay", "text": "The original work was in Marathi", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:39:46Z", "username": "Khandoba", "text": "Savarkar’s politics aside, he was a gifted poet", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:40:07Z", "username": "Akshay", "text": "He was an intellectual", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:40:17Z", "username": "Pavan Pamidimarri", "text": "TIL", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:40:18Z", "username": "Akshay", "text": "Unlike his descendants 😁", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:41:13Z", "username": "Khandoba", "text": "“intellectuals” are dime a dozen, were even back then, I’m talking specifically of his literary prowess", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:42:06Z", "username": "Khandoba", "text": "Many of his Marathi poems were in state board syllabus", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:42:32Z", "username": "Khandoba", "text": "The one I like more than anything is “Bhumates”(ode to the motherland)", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:42:40Z", "username": "Akshay", "text": "His English prose is quite skilful too", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:44:07Z", "username": "Akshay", "text": "Few with his intellect and erudition i’d say", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:45:16Z", "username": "Khandoba", "text": "I can’t comment", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-28T04:46:57Z", "username": "Khandoba", "text": "https://youtu.be/I4pJ0aD5RtA?si=P6zdAeA7OIhyRM1N\nThis is a rendition of one of his poems by Lata di, used to wake up to this often for years", "role": "chat", "is_correct": null, "has_media": false, "media": null}]