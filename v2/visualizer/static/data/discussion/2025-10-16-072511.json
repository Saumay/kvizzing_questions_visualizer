[{"timestamp": "2025-10-16T07:25:17Z", "username": "Surabhi", "text": "Phantom", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-16T07:25:19Z", "username": "Lzafeer Ahmad B F", "text": "Phantom", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-16T07:25:21Z", "username": "Naman Maheshwari", "text": "If I ever own a restaurant, I'll have a dish called bhaji pao mastani", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T07:25:33Z", "username": "Khandoba", "text": "Should have said cigarette brand", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T07:25:54Z", "username": "Naman Maheshwari", "text": "Could be a 2 course meal now that I think about it. Pao bhaji and dessert 😛", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T07:26:44Z", "username": "Abhishek S", "text": "Have Sambhaji pao", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T07:27:07Z", "username": "Kartikey Pradhan", "text": "The leftmost is Anand Balraj", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T07:27:38Z", "username": "Sidhesh K K", "text": "If anyone follows weird street food reviews by Rohan shah.... this might make it there....\nThere's already someone who converted bhaji into a stone cold Ice-cream.... add pav to it.. blend it... more pavbhaji and you have the dish", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T07:27:58Z", "username": "Khandoba", "text": "Sounds disgusting", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T07:28:24Z", "username": "Abhishek S", "text": "He was in Ram Lakhan too, right? The one in the \"Main hoo woh Hero