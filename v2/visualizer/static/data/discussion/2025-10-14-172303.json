[{"timestamp": "2025-10-14T17:24:04Z", "username": "Pavan Pamidimarri", "text": "Is it Bandel, your hometown?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:24:13Z", "username": "Naman Maheshwari", "text": "Oh I know this, can't remember right now. My cousin has a restaurant where he uses it", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:24:21Z", "username": "Naman Maheshwari", "text": "Yes bandel!", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:24:21Z", "username": "Tapish", "text": "Yes! ❤️", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:24:50Z", "username": "Pavan Pamidimarri", "text": "TIL that Bandel was once a Portuguese colony", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:25:04Z", "username": "Pavan Pamidimarri", "text": "I only knew about Chandannagar’s French legacy", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:25:18Z", "username": "Tapish", "text": "It was. They retreated there after they lost to Shah Jahan in Hooghly.", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:25:32Z", "username": "Saara", "text": "Oooo had Bandel cheese at Burma Burma", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:25:34Z", "username": "Saara", "text": "Sooo good", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:25:39Z", "username": "Saara", "text": "Didn’t know the legacy", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:26:14Z", "username": "Tapish", "text": "It’s my hometown, and I got aware of this legacy when I was in class 9-10, it’s so lost in time.", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:27:44Z", "username": "Pavan Pamidimarri", "text": "Just last weekend my wife and I were talking about why almost all Bengali sweet dishes use chhena while no south Indian sweets do. TIL that the answer may lie with the Portuguese settlement in Bandel!", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:27:44Z", "username": "Tapish", "text": "https://www.peepultree.world/livehistoryindia/story/living-culture/cheese-binding-bengal-and-portugal\nMore on this.", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:28:28Z", "username": "Pavan Pamidimarri", "text": "I was telling her that my people consider it a taboo and she wouldn’t believe me", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:29:09Z", "username": "Tapish", "text": "Even the various versions of Rosogolla or rasgulla in north India don’t use chhena.", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:34:53Z", "username": "Lzafeer Ahmad B F", "text": "When I had gone  to BHubaneswar on work, the recommended local dessert was Chenna Poda described as “traditional cheesecake”. And if you go by the preparation, the description isn’t incorrect.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:46:58Z", "username": "Aditi Bapat", "text": "Interesting, is it because of the \"splitting\" of milk considered to be a bad thing? Afaik Maharashtrian sweets don't use chhena either, and that might be why.", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:50:33Z", "username": "Akshay", "text": "Yes the arakan mags learnt it from the portuguese", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-14T17:52:14Z", "username": "Pavan Pamidimarri", "text": "Yes, that is what I was told", "role": "chat", "is_correct": null, "has_media": false, "media": null}]