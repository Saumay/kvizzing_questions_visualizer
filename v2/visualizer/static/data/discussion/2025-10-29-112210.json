[{"timestamp": "2025-10-29T11:22:17Z", "username": "Lzafeer Ahmad B F", "text": "Very easy", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:22:50Z", "username": "Abhishek Vats", "text": "Zlatan?😂", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:22:59Z", "username": "Lzafeer Ahmad B F", "text": "HAHAHHAAHA", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:23:31Z", "username": "Lzafeer Ahmad B F", "text": "THis is as much a movie related question", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:23:39Z", "username": "Abhishek S", "text": "Ikea?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:23:40Z", "username": "Lzafeer Ahmad B F", "text": "So @⁨~Abhishek S⁩ should get it", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:24:45Z", "username": "Abhishek Vats", "text": "Does sound like Zlatan though 😂😂", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:25:11Z", "username": "Lzafeer Ahmad B F", "text": "I was thinking you did college prior to the era of streaming services and WATCHED a lot of movies", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:25:29Z", "username": "Abhishek Vats", "text": "Pirate bay?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:25:40Z", "username": "Lzafeer Ahmad B F", "text": "Sahi jawaab", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:25:46Z", "username": "Abhishek S", "text": "I did, but didn't use torrents", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:25:48Z", "username": "Lzafeer Ahmad B F", "text": "Piratebay’s response to Dreamworks", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:27:37Z", "username": "Abhishek S", "text": "Mere time par CDs aur DVDs hoti thi 🙈 And later hard disks 😆", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:28:06Z", "username": "Lzafeer Ahmad B F", "text": "HAhahaha. I did my college through the transition phase.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:28:10Z", "username": "Abhishek S", "text": "I remember an instant when the video parlor guy came to the hostel cause I hadn't returned My cousin Vinny for 2 weeks", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:28:49Z", "username": "Lzafeer Ahmad B F", "text": "In my first year I had a 100 CD MoserBaer set on which I would burn movies and music. Never used them after the 2nd year.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:29:15Z", "username": "Lzafeer Ahmad B F", "text": "HDD zindabad", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:29:24Z", "username": "Abhishek S", "text": "Also, I had a TV in my hostel room. And a cable connection.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:29:34Z", "username": "Abhishek S", "text": "For the first 3 yrs", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:30:31Z", "username": "Abhishek S", "text": "Someone even wrote an anonymous letter to my parents snitching me out, hoping I'd \"get on the right track\"", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:36:16Z", "username": "Abhishek S", "text": "This is Asit Sen, btw", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:44:28Z", "username": "Lzafeer Ahmad B F", "text": "In our college there’s a story that goes,  the admin called the parents of one of the students and said:- “your son doesn’t attend classes.” The father said:- “Toh mere ghar pe thodi sota hai. aap logon ka hostel hai. Aap hi uthake le chalo class”", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T11:56:15Z", "username": "Kartikey Pradhan", "text": "Missed this question, knew it. My mom and I always share a laughter discussing his roles. Especially the one in Anand, where he was this patient in placebo. Isko kahin na kahin dard hota rehta tha. And then he tells the doctor AB one day “Doctor saab mujhe lagta hai mujhe shifting pain ki beemari ho gayi hai” 😂😂😂😂😂", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:02:04Z", "username": "Abhishek S", "text": "Scheduling this for Sunday Evening 9:30ish PM IST. Please indicate if you're available @⁨Abhishek Vats⁩ @⁨Akshay⁩ @⁨Kartikey Pradhan⁩ @⁨~Khandoba⁩", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:04:15Z", "username": "Kartikey Pradhan", "text": "Where is Rashford as an option?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:04:33Z", "username": "Abhishek S", "text": "Not giving anyone an easy way out of this poll", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:07:14Z", "username": "Naman Agarwal", "text": "Let's see if anyone votes", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:07:34Z", "username": "Farhan", "text": "I voted for everyone once and deselected", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:11:47Z", "username": "Abhishek S", "text": "I am supposed to be neutral so I can't vote. But why isn't anyone else! ‎<This message was edited>", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:12:01Z", "username": "Abhishek S", "text": "End me ye chaaro hi ek doosre ko vote dene wale hai", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:13:07Z", "username": "Naman Agarwal", "text": "Even that's hard to arrange right?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:13:28Z", "username": "Abhishek S", "text": "Finally, Akshay has the lead!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:14:10Z", "username": "Naman Agarwal", "text": "Someone finally came off the fence! Well done @⁨~Nikunj⁩", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:14:32Z", "username": "Nikunj", "text": "Voted for Mr. Overachiever", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:14:41Z", "username": "Abhishek S", "text": "Which means all of them will vote for him - and he'll act all modest. So expected.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:15:40Z", "username": "Abhishek S", "text": "For all the Kohli fans we have here, everyone is being so Dravid.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:15:58Z", "username": "Sidhesh K K", "text": "Voted for Vats!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:16:22Z", "username": "Sidhesh K K", "text": "Koi aise hi Pavan ka streak match nahi karta", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:16:26Z", "username": "Naman Agarwal", "text": "Btw @⁨~Abhishek S⁩ how did you draw the SFs ?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-29T12:16:54Z", "username": "Abhishek S", "text": "Ensuring the same quarterfinalists don't end up in the same semfinal", "role": "chat", "is_correct": null, "has_media": false, "media": null}]