[{"timestamp": "2025-12-24T05:35:22Z", "username": "Dhruv", "text": "Either of X or Y is Thailand, I believe its X", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:35:33Z", "username": "Pavan Pamidimarri", "text": "Y is Thailand", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:35:48Z", "username": "Dhruv", "text": "then X is chinese ?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:36:06Z", "username": "Nikunj", "text": "Cambodia??", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:36:09Z", "username": "Pavan Pamidimarri", "text": "The Chinese government pressured the X military to raid the park", "role": "hint", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:36:22Z", "username": "Nikunj", "text": "Laos?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:36:24Z", "username": "Dhruv", "text": "Viet?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:36:34Z", "username": "Farhan", "text": "Myanmar", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:36:57Z", "username": "Pavan Pamidimarri", "text": "Myanmar is correct. Its lawlessness was a perfect set up for massive pig butchering operations", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:37:02Z", "username": "Nikunj", "text": "Jitne border countries this sab bol di", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:37:31Z", "username": "Sidhesh K K", "text": "China border kya", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:37:43Z", "username": "Pavan Pamidimarri", "text": "They would place ads in places like West Africa and Nepal, about jobs in Thailand. You show up at Bangkok airport, a driver picks you up and drives to the Myanmar border, and armed goons kidnap you to the compound and you become a slave.", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:38:08Z", "username": "Pavan Pamidimarri", "text": "Many Chinese citizens were enslaved in that compound", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:38:36Z", "username": "Pavan Pamidimarri", "text": "The gangsters made money in two ways: pig butchering, plus ransom for their enslaved workers.", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:38:52Z", "username": "Pavan Pamidimarri", "text": "Families had to pay approximately $100,000 to get a worker out of Myanmar back home", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:40:01Z", "username": "Pavan Pamidimarri", "text": "Economist magazine had a great podcast this year about it, called Scam, Inc. https://www.economist.com/audio/podcasts/scam-inc", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-12-24T05:41:29Z", "username": "Pavan Pamidimarri", "text": "border between Myanmar and Thailand.", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]