[{"timestamp": "2025-10-01T16:55:19Z", "username": "Lzafeer Ahmad B F", "text": "My original guess for 4th blank I was typing was God. Assuming it was a quote by our supreme leader", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T16:55:34Z", "username": "Lzafeer Ahmad B F", "text": "In some political rally", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T16:56:21Z", "username": "Lzafeer Ahmad B F", "text": "Calendar?", "role": "attempt", "is_correct": false, "has_media": false, "media": null}, {"timestamp": "2025-10-01T16:56:43Z", "username": "Pavan Pamidimarri", "text": "No, the Mesopotamians had calendars", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T16:57:56Z", "username": "Lzafeer Ahmad B F", "text": "Correct date for Easter …. I am assuming this is the hint", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T16:58:18Z", "username": "Pavan Pamidimarri", "text": "yes, main thing to focus on.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T16:58:39Z", "username": "Akshay", "text": "He is also OBC ;)", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T16:58:40Z", "username": "Sidhesh K K", "text": "The BC AD dating?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-01T16:59:13Z", "username": "Pavan Pamidimarri", "text": "Correct, Dennis invented the way of numbering years that we use today. He called it AD", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T16:59:16Z", "username": "Lzafeer Ahmad B F", "text": "Super crack!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T16:59:18Z", "username": "Akshay", "text": "Nice Q!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:00:03Z", "username": "Pavan Pamidimarri", "text": "Before his time, years were denoted by the regin of the king — “in the third year of the reign of King X”", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:00:18Z", "username": "Lzafeer Ahmad B F", "text": "TIL", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:00:18Z", "username": "Pavan Pamidimarri", "text": "and they had a system of dating going back to the founding of hte city of Rome, but that was rarely used", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:00:57Z", "username": "Pavan Pamidimarri", "text": "BTW in many ancient Indian inscriptions, you see a similar scheme — “King Piyadasi, beloved of the gods, in the Xth year of his reign, did such and such\"", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:01:32Z", "username": "Khandoba", "text": "Yes, seen this type in various texts", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:02:45Z", "username": "Lzafeer Ahmad B F", "text": "Makes sense that AD came much later. Now that I think of it, it’s kinda silly to think that people collectively decided at the time of happening that from now on we will count the past as BC and the future as AD.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:03:16Z", "username": "Pavan Pamidimarri", "text": "exactly.", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:03:59Z", "username": "Lzafeer Ahmad B F", "text": "Of course someone would have had to relate it back and then record it.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:04:03Z", "username": "Lzafeer Ahmad B F", "text": "Super question!", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:04:21Z", "username": "Pavan Pamidimarri", "text": "i think it’s also a function of technology that makes such broad adoptions possible. for instance, the Hijri calendar was adopted fairly quickly", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:04:40Z", "username": "Pavan Pamidimarri", "text": "dating year 1 to the migration to MEdina", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:05:21Z", "username": "Akshay", "text": "So also the julian to gregorian switch", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:05:36Z", "username": "Akshay", "text": "Which happened over weeks iirc", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:05:46Z", "username": "Pavan Pamidimarri", "text": "yes", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:06:58Z", "username": "Pavan Pamidimarri", "text": "if i remember correctly, the caliphate adopted the Hijri era within a few years after Muhammad’s passing", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:22:55Z", "username": "Sidhesh K K", "text": "Very unlikely you're incorrect", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:23:23Z", "username": "Akshay", "text": "I realized what was throwing me off. I read dionysius and went to the greek philosopher. Who lived loong before christ", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:23:43Z", "username": "Akshay", "text": "Koi shaq", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:24:11Z", "username": "Akshay", "text": "Diogenes", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-01T17:24:12Z", "username": "Pavan Pamidimarri", "text": "It’s also the name of the Greek equivalent of Shiva", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}]