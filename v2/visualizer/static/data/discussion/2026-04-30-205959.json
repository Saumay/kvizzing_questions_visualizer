ia": null}, {"timestamp": "2026-04-30T21:08:40Z", "username": "Akshay", "text": "His job also got DOGEd lol", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T21:08:45Z", "username": "Akshay", "text": "$20/hr job", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T21:08:49Z", "username": "Pavan Pamidimarri", "text": "crazy", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T21:08:50Z", "username": "Akshay", "text": "Like so random", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T21:09:30Z", "username": "Pavan Pamidimarri", "text": "taking a chainsaw to government looks exactly like what DOGE did", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T21:09:48Z", "username": "Akshay", "text": "Yeah, extremely scattershot and haphazard", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T21:09:55Z", "username": "Akshay", "text": "Worst of all worlds", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-04-30T21:10:10Z", "username": "Pavan Pamidimarri", "text": "but my worry now is what happens if we slip into recession? or the war escalates?", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]