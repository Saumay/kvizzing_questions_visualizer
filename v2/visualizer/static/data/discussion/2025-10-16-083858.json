t": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:42:05Z", "username": "Khandoba", "text": "Was Saransh Goila a contestant on Masterchef Aus?", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:42:13Z", "username": "Abhishek S", "text": "Guest, I guess", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:42:22Z", "username": "Sidhesh K K", "text": "No... he was a celebrity judge", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:42:23Z", "username": "Tapish", "text": "I remember this was a guest episode", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:42:26Z", "username": "Tapish", "text": "Yes!", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:42:27Z", "username": "Khandoba", "text": "Oh ok, that makes sense", "role": "attempt", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:42:44Z", "username": "Sidhesh K K", "text": "The twist is a smoke using ghee and charcoal", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:43:06Z", "username": "Tapish", "text": "Dhunkar or dhungar", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:43:07Z", "username": "Abhishek S", "text": "That is a must for Butter chicken anyway", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:43:12Z", "username": "Kartikey Pradhan", "text": "Butter emu is hilariousssss", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:43:21Z", "username": "Kartikey Pradhan", "text": "Butter kiwi", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:43:23Z", "username": "Khandoba", "text": "Bdw Masterchef Australia, best out of all the editions", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:43:51Z", "username": "Lzafeer Ahmad B F", "text": "Truly what the hell Pavan.", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:44:12Z", "username": "Sidhesh K K", "text": "Had the pleasure of meeting him at Goila Butter chicken in versova... after the episode... very nice person", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:44:38Z", "username": "Khandoba", "text": "Delish-us guy", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:44:52Z", "username": "Khandoba", "text": "Because he says delish-us", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:44:54Z", "username": "Kartikey Pradhan", "text": "If you guys are ever in Dubai, you should try Roobaroo’s butter chicken. Criminally underrated, perhaps the best I have ever had", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:45:01Z", "username": "Khandoba", "text": "Nothing else before people start making jokes", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:46:24Z", "username": "Kartikey Pradhan", "text": "I often wonder what made showmakers think that India’s answer to a Gordon Ramsay or a Simon Cowell on a judge panel should be Anu Malik", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:46:40Z", "username": "Khandoba", "text": "Ye kab hua", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:46:55Z", "username": "Kartikey Pradhan", "text": "If you think of it, every judge panel has a bad cop", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:47:24Z", "username": "Kartikey Pradhan", "text": "And there have been some iconic bad cops across reality TV", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:47:40Z", "username": "Sidhesh K K", "text": "Because he mixes both worlds.... he's the only one who can say Antara... tumne khaya suron wala santra", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:47:59Z", "username": "Tapish", "text": "Chetan Bhagat and Nach Baliye ❤️🤌", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:48:21Z", "username": "Kartikey Pradhan", "text": "There the cop himself was pretty bad", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:48:53Z", "username": "Khandoba", "text": "https://youtu.be/1Gu31HGz7yE?si=QiTyyEpsnbX3tmDG", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:49:08Z", "username": "Kartikey Pradhan", "text": "Hahahahahahahaha I luurrveeee key and peele", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-16T08:50:17Z", "username": "Abhishek S", "text": "I still remember this joke Sajid Khan cracked (in either Ikke pe Ikka, or Kehne me kya harz hai) about Antara Mali: \"Antara achha hai, mukhda kharaab hai.\" 🙈🙈🙈", "role": "elaboration", "is_correct": null, "has_media": false, "media": null}]