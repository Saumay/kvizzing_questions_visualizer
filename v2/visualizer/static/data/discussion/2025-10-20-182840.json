[{"timestamp": "2025-10-20T18:32:02Z", "username": "Khandoba", "text": "Something to do with Kalidasa?", "role": "attempt", "is_correct": true, "has_media": false, "media": null}, {"timestamp": "2025-10-20T18:32:25Z", "username": "Akshay", "text": "Correct! This is Kalidas, the first ever Tamil-Telugu talkie", "role": "confirmation", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-20T18:32:47Z", "username": "Shubham", "text": "Bhagat Singh?", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-20T18:33:01Z", "username": "Akshay", "text": "Cinema TPR refers to TP Rajalakshmi, actress and social activist", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-20T18:33:11Z", "username": "Akshay", "text": "That became her nickname after this film", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-20T18:33:18Z", "username": "Khandoba", "text": "I have been pasting that same answer for some time and getting points 😬", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-20T18:34:16Z", "username": "Akshay", "text": "Released the same year as Alam Ara, the first Indian talkie this followed after, they used the same set", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-20T18:34:25Z", "username": "Akshay", "text": "Also released on Diwali for max response", "role": "answer_reveal", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-20T18:34:32Z", "username": "Akshay", "text": "Yet another trend :)", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2025-10-20T18:34:40Z", "username": "Akshay", "text": "Only now it’s bhoi", "role": "chat", "is_correct": null, "has_media": false, "media": null}]