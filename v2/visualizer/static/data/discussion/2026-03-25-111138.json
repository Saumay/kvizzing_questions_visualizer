estamp": "2026-03-25T11:24:46Z", "username": "Sidhesh K K", "text": "Latte aur 3 mojito", "role": "chat", "is_correct": null, "has_media": false, "media": null}, {"timestamp": "2026-03-25T11:25:00Z", "username": "Smit D Mahajani", "text": "Yeah me too", "role": "chat", "is_correct": null, "has_media": false, "media": null}]